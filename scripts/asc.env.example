# App Store Connect API の識別子（scripts/submit-appstore.py が読む）。
# このファイルを scripts/asc.env にコピーして記入する（asc.env は gitignore 済み）。
# 秘密鍵 .p8 本体は ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8 に置く。
# 値は ASC → ユーザとアクセス → 統合 → App Store Connect API（Issuer ID / キーID）、
# App ID は ASC → マイApp → アプリ情報 → Apple ID。
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_APP_ID=
